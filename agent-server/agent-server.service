[Unit]
Description=Live-answer agent server for the chat assistant
After=network.target

[Service]
Type=simple
User=ticketbot
# NOTE: paths are absolute on purpose -- in system units %h always expands to
# /root, not to the User= home, so %h must not be used here.
WorkingDirectory=/home/ticketbot/freescout-ticket-solver
EnvironmentFile=/home/ticketbot/agent-server/agent.env
ExecStart=/usr/bin/python3 /home/ticketbot/agent-server/server.py
Restart=on-failure
RestartSec=5
# The CLI needs normal home-dir access (auth, state, repos); keep sandboxing
# minimal. Further lockdown (ProtectSystem/ProtectHome) is possible once the
# CLI's write paths on this box are known.
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
